<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>ShopAI</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#F2F2F7;--surface:#FFF;--surface2:#F8F8FC;--surface3:#F0F0F8;--border:rgba(0,0,0,0.08);--border2:rgba(0,0,0,0.05);--accent:#0A84FF;--accent2:#5E5CE6;--accent-light:#EAF3FF;--text:#1C1C1E;--text2:#48484A;--muted:#8E8E93;--green:#30D158;--shadow-sm:0 1px 8px rgba(0,0,0,0.06);--shadow:0 4px 24px rgba(0,0,0,0.08)}
body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;height:100vh;display:flex;flex-direction:column;overflow:hidden}
header{height:64px;background:rgba(255,255,255,0.9);backdrop-filter:blur(30px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 28px;z-index:100}
.logo{display:flex;align-items:center;gap:10px}
.logo-icon{width:36px;height:36px;background:linear-gradient(145deg,#0A84FF,#5E5CE6);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 4px 12px rgba(10,132,255,0.35)}
.logo-name{font-family:'Playfair Display',serif;font-size:20px;font-weight:600;letter-spacing:-0.3px}
.logo-name span{color:var(--accent)}
.header-right{display:flex;align-items:center;gap:12px}
.catalog-pill{background:linear-gradient(135deg,#EAF3FF,#EDE9FF);border:1px solid rgba(10,132,255,0.15);border-radius:20px;padding:6px 14px;font-size:12px;color:var(--accent2);font-weight:600}
.model-pill{display:flex;align-items:center;gap:7px;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:6px 14px;font-size:12.5px;color:var(--text2);font-weight:500;box-shadow:var(--shadow-sm)}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:glow 2s infinite}
@keyframes glow{0%,100%{box-shadow:0 0 0 2px rgba(48,209,88,0.25)}50%{box-shadow:0 0 0 4px rgba(48,209,88,0.15)}}
.layout{flex:1;display:flex;overflow:hidden}
.sidebar{width:272px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sidebar-section{padding:20px 16px 12px}
.sidebar-label{font-size:10.5px;font-weight:600;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;padding:0 6px;margin-bottom:8px}
.chip-grid{display:flex;flex-wrap:wrap;gap:6px}
.chip{background:var(--surface2);border:1px solid var(--border);border-radius:20px;padding:6px 13px;font-size:12.5px;color:var(--text2);cursor:pointer;transition:all 0.18s;font-family:'Outfit',sans-serif}
.chip:hover{background:var(--accent-light);border-color:rgba(10,132,255,0.25);color:var(--accent)}
.sidebar-divider{height:1px;background:var(--border2);margin:4px 16px}
.mode-section{padding:12px 16px}
.mode-cards{display:flex;flex-direction:column;gap:6px}
.mode-card{border:1px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:all 0.2s;background:var(--surface)}
.mode-card:hover{border-color:rgba(10,132,255,0.2);background:var(--accent-light)}
.mode-card.active{border-color:var(--accent);background:linear-gradient(135deg,rgba(10,132,255,0.06),rgba(94,92,230,0.04));box-shadow:0 2px 12px rgba(10,132,255,0.1)}
.mode-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:3px}
.mode-card-name{font-size:13px;font-weight:600;color:var(--text)}
.mode-card.active .mode-card-name{color:var(--accent)}
.mode-badge{font-size:10px;font-weight:600;padding:2px 7px;border-radius:20px;background:var(--accent-light);color:var(--accent);letter-spacing:0.04em}
.mode-card-desc{font-size:11.5px;color:var(--muted);line-height:1.4;font-weight:300}
.history-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:10px;cursor:pointer;transition:background 0.15s}
.history-item:hover{background:var(--surface2)}
.history-icon{width:28px;height:28px;border-radius:8px;background:var(--surface3);display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.history-text{font-size:12.5px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:300}
#chat-wrap{flex:1;display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}
#chat{flex:1;overflow-y:auto;padding:36px 48px;display:flex;flex-direction:column;gap:28px}
#chat::-webkit-scrollbar{width:3px}
#chat::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60px 20px;gap:18px;animation:fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) both}
.welcome-icon-wrap{width:80px;height:80px;background:linear-gradient(145deg,#fff,var(--surface2));border:1px solid var(--border);border-radius:24px;display:flex;align-items:center;justify-content:center;font-size:38px;box-shadow:var(--shadow);margin-bottom:8px}
.welcome h1{font-family:'Playfair Display',serif;font-size:36px;font-weight:500;letter-spacing:-0.5px;line-height:1.2}
.welcome p{font-size:15px;color:var(--muted);max-width:420px;line-height:1.7;font-weight:300}
.welcome-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:8px}
.welcome-chip{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:8px 18px;font-size:13px;color:var(--text2);cursor:pointer;transition:all 0.2s;box-shadow:var(--shadow-sm);font-family:'Outfit',sans-serif}
.welcome-chip:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-light);transform:translateY(-1px)}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.message{display:flex;gap:14px;max-width:800px;width:100%;margin:0 auto;animation:fadeUp 0.35s cubic-bezier(0.16,1,0.3,1) both}
.message.user{flex-direction:row-reverse}
.avatar{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;margin-top:2px}
.avatar.ai-av{background:linear-gradient(145deg,#0A84FF,#5E5CE6);box-shadow:0 4px 12px rgba(10,132,255,0.3);color:white;font-size:16px}
.avatar.user-av{background:var(--surface);border:1px solid var(--border);color:var(--muted)}
.bubble{padding:14px 18px;border-radius:18px;font-size:14.5px;line-height:1.68;max-width:calc(100% - 52px)}
.message.user .bubble{background:linear-gradient(135deg,#0A84FF,#5E5CE6);color:white;border-top-right-radius:4px;box-shadow:0 4px 20px rgba(10,132,255,0.25)}
.message.ai .bubble{background:var(--surface);border:1px solid var(--border);border-top-left-radius:4px;box-shadow:var(--shadow-sm)}
.products-label{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:0.07em;text-transform:uppercase;margin-bottom:10px}
.products-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.product-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:14px 16px;min-width:155px;flex:1;transition:all 0.22s cubic-bezier(0.16,1,0.3,1);position:relative;overflow:hidden}
.product-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent),var(--accent2));opacity:0;transition:opacity 0.2s}
.product-card:hover{border-color:rgba(10,132,255,0.2);box-shadow:0 8px 24px rgba(10,132,255,0.1);transform:translateY(-2px)}
.product-card:hover::before{opacity:1}
.product-name{font-family:'Playfair Display',serif;font-size:13px;font-weight:500;color:var(--text);margin-bottom:5px;line-height:1.35}
.product-sku{font-size:11px;color:var(--muted);margin-bottom:10px}
.product-price{font-size:17px;font-weight:600;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ai-text{margin-top:4px;padding-top:14px;border-top:1px solid var(--border2);color:var(--text2);font-size:14px;line-height:1.72;font-weight:300}
.typing{display:flex;align-items:center;gap:5px;padding:14px 18px}
.typing span{width:7px;height:7px;border-radius:50%;background:var(--muted);animation:tb 1.2s infinite}
.typing span:nth-child(2){animation-delay:0.18s}
.typing span:nth-child(3){animation-delay:0.36s}
@keyframes tb{0%,80%,100%{transform:translateY(0);opacity:0.35}40%{transform:translateY(-6px);opacity:1}}
.input-zone{padding:18px 48px 24px;background:rgba(242,242,247,0.95);backdrop-filter:blur(24px);border-top:1px solid var(--border)}
.input-box{display:flex;align-items:flex-end;gap:10px;max-width:800px;margin:0 auto;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:12px 12px 12px 20px;box-shadow:var(--shadow);transition:border-color 0.2s,box-shadow 0.2s}
.input-box:focus-within{border-color:rgba(10,132,255,0.4);box-shadow:0 0 0 4px rgba(10,132,255,0.07),var(--shadow)}
textarea#q{flex:1;background:none;border:none;outline:none;font-family:'Outfit',sans-serif;font-size:15px;color:var(--text);resize:none;max-height:120px;line-height:1.5}
textarea#q::placeholder{color:var(--muted)}
#go{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#0A84FF,#5E5CE6);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:opacity 0.15s,transform 0.1s;box-shadow:0 4px 14px rgba(10,132,255,0.35)}
#go:hover{opacity:0.88;transform:scale(1.05)}
#go:active{transform:scale(0.95)}
#go:disabled{opacity:0.3;cursor:not-allowed;transform:none}
#go svg{width:17px;height:17px;fill:white}
.input-footer{display:flex;align-items:center;justify-content:center;gap:16px;max-width:800px;margin:10px auto 0}
.footer-tag{font-size:11.5px;color:var(--muted);font-weight:300}
.footer-dot{width:3px;height:3px;border-radius:50%;background:var(--muted)}
.err{background:#FFF2F2;border:1px solid rgba(255,59,48,0.2);border-radius:12px;padding:12px 16px;color:#D70015;font-size:13.5px}
</style>
</head>
<body>
<header>
  <div class="logo">
    <div class="logo-icon">🛍️</div>
    <span class="logo-name">Shop<span>AI</span></span>
  </div>
  <div class="header-right">
    <div class="catalog-pill">2,040 Products</div>
    <div class="model-pill"><div class="live-dot"></div>Llama 3.2 · Live</div>
  </div>
</header>
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">Quick searches</div>
      <div class="chip-grid">
        <button class="chip" onclick="go('I need a backpack')">🎒 Backpack</button>
        <button class="chip" onclick="go('under 40 dollars')">💸 Under $40</button>
        <button class="chip" onclick="go('travel bag')">✈️ Travel</button>
        <button class="chip" onclick="go('gym bag')">💪 Gym</button>
        <button class="chip" onclick="go('best jacket under 60 dollars')">🧥 Jacket</button>
        <button class="chip" onclick="go('yoga pants for women')">🧘 Yoga</button>
        <button class="chip" onclick="go('running shoes')">👟 Running</button>
        <button class="chip" onclick="go('waterproof bag')">🌧️ Waterproof</button>
      </div>
    </div>
    <div class="sidebar-divider"></div>
    <div class="mode-section">
      <div class="sidebar-label" style="padding:0 6px;margin-bottom:10px;">AI Mode</div>
      <div class="mode-cards">
        <div class="mode-card active" id="m-chat" onclick="setMode('chat')">
          <div class="mode-card-top"><span class="mode-card-name">Direct</span><span class="mode-badge">FAST</span></div>
          <div class="mode-card-desc">Vector search + Llama 3.2 direct pipeline</div>
        </div>
        <div class="mode-card" id="m-rag" onclick="setMode('rag')">
          <div class="mode-card-top"><span class="mode-card-name">RAG</span><span class="mode-badge">SMART</span></div>
          <div class="mode-card-desc">LangChain retrieval-augmented generation</div>
        </div>
      </div>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
      <div class="sidebar-label">Recent searches</div>
      <div id="history"></div>
    </div>
  </aside>
  <div id="chat-wrap">
    <div id="chat">
      <div class="welcome" id="welcome">
        <div class="welcome-icon-wrap">🛍️</div>
        <h1>What are you looking for?</h1>
        <p>Describe what you need in plain English. I will search 2,040 products and find the best match for you.</p>
        <div class="welcome-chips">
          <button class="welcome-chip" onclick="go('I need a stylish backpack for college')">🎒 College backpack</button>
          <button class="welcome-chip" onclick="go('something comfortable for yoga')">🧘 Yoga gear</button>
          <button class="welcome-chip" onclick="go('best bag under 50 dollars')">💸 Budget under $50</button>
          <button class="welcome-chip" onclick="go('lightweight jacket for travel')">✈️ Travel jacket</button>
        </div>
      </div>
    </div>
    <div class="input-zone">
      <div class="input-box">
        <textarea id="q" rows="1" placeholder="Ask about any product..." onkeydown="onKey(event)" oninput="resize(this)"></textarea>
        <button id="go" onclick="send()">
          <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
      <div class="input-footer">
        <span class="footer-tag">pgvector semantic search</span>
        <div class="footer-dot"></div>
        <span class="footer-tag" id="mode-label">Direct mode</span>
        <div class="footer-dot"></div>
        <span class="footer-tag">Fully local · No cloud</span>
      </div>
    </div>
  </div> </div> <script> const 
API='http://localhost:8002',chat=document.getElementById('chat'),input=document.getElementById('q'),btn=document.getElementById('go'),historyEl=document.getElementById('history'); 
let mode='chat',shown=false,searches=[]; function 
setMode(m){mode=m;document.getElementById('m-chat').classList.toggle('active',m==='chat');document.getElementById('m-rag').classList.toggle('active',m==='rag');document.getElementById('mode-label').textContent=m==='chat'?'Direct 
mode':'RAG mode';} function 
resize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,120)+'px';} 
function 
onKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}} 
function go(text){input.value=text;send();} function 
removeWelcome(){if(!shown){const 
w=document.getElementById('welcome');if(w)w.remove();shown=true;}} 
function 
addHistory(text){if(searches.length>=5)searches.shift();searches.push(text);historyEl.innerHTML=searches.slice().reverse().map(s=>'<div 
class="history-item" 
onclick="go(\''+s.replace(/'/g,"\\'")+'\')">'+'<div 
class="history-icon">🔍</div><div 
class="history-text">'+s+'</div></div>').join('');} 
function addMsg(role,content){removeWelcome();const 
msg=document.createElement('div');msg.className='message 
'+role;const 
av=document.createElement('div');av.className='avatar 
'+(role==='ai'?'ai-av':'user-av');av.textContent=role==='ai'?'✦':'↑';const 
bub=document.createElement('div');bub.className='bubble';if(typeof 
content==='string')bub.textContent=content;else 
bub.appendChild(content);msg.appendChild(av);msg.appendChild(bub);chat.appendChild(msg);chat.scrollTop=chat.scrollHeight;} 
function showTyping(){removeWelcome();const 
msg=document.createElement('div');msg.className='message 
ai';msg.id='typing';const 
av=document.createElement('div');av.className='avatar 
ai-av';av.textContent='✦';const 
bub=document.createElement('div');bub.className='bubble';bub.innerHTML='<div 
class="typing"><span></span><span></span><span></span></div>';msg.appendChild(av);msg.appendChild(bub);chat.appendChild(msg);chat.scrollTop=chat.scrollHeight;} 
function removeTyping(){const 
t=document.getElementById('typing');if(t)t.remove();} 
function buildResult(data){const 
wrap=document.createElement('div');if(data.products_found&&data.products_found.length>0){const 
lbl=document.createElement('div');lbl.className='products-label';lbl.textContent=data.products_found.length+' 
Products Found';wrap.appendChild(lbl);const 
row=document.createElement('div');row.className='products-row';data.products_found.forEach(function(p){const 
card=document.createElement('div');card.className='product-card';card.innerHTML='<div 
class="product-name">'+p.name+'</div><div 
class="product-sku">SKU: '+p.sku+'</div><div 
class="product-price">$'+parseFloat(p.price).toFixed(2)+'</div>';row.appendChild(card);});wrap.appendChild(row);}const 
txt=document.createElement('div');txt.className='ai-text';txt.textContent=data.ai_response||data.answer||'';wrap.appendChild(txt);return 
wrap;} async function send(){const 
q=input.value.trim();if(!q)return;input.value='';input.style.height='auto';btn.disabled=true;addMsg('user',q);addHistory(q);showTyping();try{const 
ep=mode==='rag'?'/rag-chat':'/chat';const res=await 
fetch(API+ep+'?query='+encodeURIComponent(q));removeTyping();if(!res.ok)throw 
new Error(res.status);const data=await 
res.json();addMsg('ai',buildResult(data));}catch(e){removeTyping();const 
d=document.createElement('div');d.className='err';d.textContent='Cannot 
reach FastAPI on port 8002. Make sure the server is 
running. 
('+e.message+')';addMsg('ai',d);}finally{btn.disabled=false;input.focus();}} 
let lastProductSku = null;

function detectNegotiation(msg) {
    const match = msg.match(/\$?([\d.]+)/);
    if (/discount|cheaper|too expensive|can i get|how about|i.ll pay|can you do/i.test(msg)) {
        return match ? parseFloat(match[1]) : 1;
    }
    return null;
}

async function negotiate(offeredPrice) {
    if (!lastProductSku) {
        addMsg('assistant', 'Please search for a product first!');
        return;
    }
    showTyping();
    const res = await fetch(`${API}/negotiate?product_sku=${lastProductSku}&offered_price=${offeredPrice}`);
    const data = await res.json();
    removeTyping();
    addMsg('assistant', data.message);
}
</body>
</html>
