from mcp.server.fastmcp import FastMCP
import httpx
import psycopg2
from pgvector.psycopg2 import register_vector
from sentence_transformers import SentenceTransformer
import requests
import urllib3
urllib3.disable_warnings()

# Initialize
mcp = FastMCP("AI Shopping Assistant")
model = SentenceTransformer("all-MiniLM-L6-v2")

MAGENTO_URL = "https://172.17.0.1"
DB_CONFIG = {
    "host": "172.17.0.1",
    "port": 5432,
    "database": "aidb",
    "user": "aiuser",
    "password": "aipassword"
}

def get_token():
    try:
        r = requests.post(
            f"{MAGENTO_URL}/rest/V1/integration/admin/token",
            json={"username": "admin", "password": "Admin@123"},
            verify=False, timeout=10
        )
        return r.json()
    except:
        return ""

MAGENTO_TOKEN = get_token()

# ── TOOL 1: Search Products ──────────────────────────────────────
@mcp.tool()
def search_products(query: str, limit: int = 5) -> list:
    """Search for products using semantic similarity search.
    Use this when the user asks for product recommendations."""
    query_embedding = model.encode(query).tolist()
    conn = psycopg2.connect(**DB_CONFIG)
    register_vector(conn)
    cur = conn.cursor()
    cur.execute(
        "SELECT name, sku, price, description FROM products ORDER BY embedding <=> %s::vector LIMIT %s",
        (query_embedding, limit)
    )
    results = cur.fetchall()
    cur.close()
    conn.close()
    return [{"name": r[0], "sku": r[1], "price": r[2], "description": r[3]} for r in results]

# ── TOOL 2: Get Stock ────────────────────────────────────────────
@mcp.tool()
def get_stock(sku: str) -> dict:
    """Check if a product is in stock by its SKU.
    Use this when the user asks about availability."""
    try:
        r = requests.get(
            f"{MAGENTO_URL}/rest/V1/stockItems/{sku}",
            headers={"Authorization": f"Bearer {MAGENTO_TOKEN}"},
            verify=False, timeout=10
        )
        data = r.json()
        return {
            "sku": sku,
            "qty": data.get("qty", 0),
            "in_stock": data.get("is_in_stock", False)
        }
    except Exception as e:
        return {"error": str(e)}

# ── TOOL 3: Get Categories ───────────────────────────────────────
@mcp.tool()
def get_categories() -> list:
    """Get all product categories from the store.
    Use this when the user asks what types of products are available."""
    try:
        r = requests.get(
            f"{MAGENTO_URL}/rest/V1/categories",
            headers={"Authorization": f"Bearer {MAGENTO_TOKEN}"},
            verify=False, timeout=10
        )
        data = r.json()
        categories = []
        def extract(node):
            if node.get("name") and node["name"] != "Root Catalog":
                categories.append({
                    "id": node.get("id"),
                    "name": node.get("name"),
                    "level": node.get("level")
                })
            for child in node.get("children_data", []):
                extract(child)
        extract(data)
        return categories
    except Exception as e:
        return [{"error": str(e)}]

# ── TOOL 4: Get Product Details ──────────────────────────────────
@mcp.tool()
def get_product_details(sku: str) -> dict:
    """Get full details of a specific product by SKU.
    Use this when the user wants to know more about a specific product."""
    try:
        r = requests.get(
            f"{MAGENTO_URL}/rest/V1/products/{sku}",
            headers={"Authorization": f"Bearer {MAGENTO_TOKEN}"},
            verify=False, timeout=10
        )
        p = r.json()
        name = p.get("name", "")
        price = p.get("price", 0)
        description = ""
        image = ""
        for attr in p.get("custom_attributes", []):
            if attr["attribute_code"] == "description":
                description = attr["value"]
            elif attr["attribute_code"] == "image":
                image = f"https://magento.test/pub/media/catalog/product{attr['value']}"
        return {
            "name": name,
            "sku": sku,
            "price": price,
            "description": description,
            "image": image
        }
    except Exception as e:
        return {"error": str(e)}

# ── TOOL 5: Get Price Range ──────────────────────────────────────
@mcp.tool()
def search_by_price(min_price: float, max_price: float) -> list:
    """Search products within a specific price range.
    Use this when the user mentions a budget like 'under $50'."""
    try:
        r = requests.get(
            f"{MAGENTO_URL}/rest/V1/products?"
            f"searchCriteria[filterGroups][0][filters][0][field]=price&"
            f"searchCriteria[filterGroups][0][filters][0][value]={min_price}&"
            f"searchCriteria[filterGroups][0][filters][0][conditionType]=gteq&"
            f"searchCriteria[filterGroups][1][filters][0][field]=price&"
            f"searchCriteria[filterGroups][1][filters][0][value]={max_price}&"
            f"searchCriteria[filterGroups][1][filters][0][conditionType]=lteq&"
            f"searchCriteria[pageSize]=10",
            headers={"Authorization": f"Bearer {MAGENTO_TOKEN}"},
            verify=False, timeout=15
        )
        items = r.json().get("items", [])
        return [{"name": p.get("name"), "sku": p.get("sku"), "price": p.get("price")} for p in items]
    except Exception as e:
        return [{"error": str(e)}]

if __name__ == "__main__":
mcp.run(transport="streamable-http", host="0.0.0.0", port=8003)
